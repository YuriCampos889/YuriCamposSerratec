programa
{
	
	funcao inicio()
	{
		real numeroX, numeroY

		escreva("Insira o numero 1: ")
		leia(numeroX)
		escreva("Insira o numero 2: ")
		leia(numeroY)

		escreva("Soma = ", numeroX+numeroY, "\n")
		escreva("Subtracao = ", numeroX-numeroY, "\n")
		escreva("multiplicacao = ", numeroX*numeroY, "\n")
		escreva("Divisão = ", numeroX/numeroY, "\n")
	}
}

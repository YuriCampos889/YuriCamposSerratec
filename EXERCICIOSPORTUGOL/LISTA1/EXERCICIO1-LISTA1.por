programa
{
	
	funcao inicio()
	{
		cadeia nome,sobrenome
			escreva("QUAL É O SEU NOME?????????")
			leia(nome)
			limpa()

			escreva("QUAL É O SEU SOBRENOME???????")
			leia(sobrenome)
			limpa()

				escreva("bem vindo(a)"+nome+" "+sobrenome+"\nespero que vc goste do mundinho da tecnologia e afins")
	}
}

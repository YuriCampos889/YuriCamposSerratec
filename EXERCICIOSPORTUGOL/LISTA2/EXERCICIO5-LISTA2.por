programa
{
	
	funcao inicio()
	{ 
        real horas, minutos
        inteiro segundos
	
	        escreva("oiii, tem horas aí????: ")
	        leia(horas)
	        
	        minutos = horas * 60
	        escreva(horas, " horas * 60 = ", minutos, " minutos\n")
	        
	        segundos = minutos * 60
	        escreva(minutos, " minutos * 60 = ", segundos, " segundos\n")
	        escreva("então", horas, " horas são equivalentes a ", segundos, " segundos. Obrigado^^")
	}
}

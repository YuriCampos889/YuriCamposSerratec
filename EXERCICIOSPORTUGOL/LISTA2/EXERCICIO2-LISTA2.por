programa
{
	
	funcao inicio()
	{	
		inteiro anoNasc, anoAt, idade
			escreva("qual é o ano do seu nascimento? ")
			leia (anoNasc)
			limpa()
	
			escreva("e por fim, em que ano estamos? ")
			leia(anoAt)
			limpa()

				idade = anoAt - anoNasc
				escreva("voce tem ", idade, " anos")

				
	}
}

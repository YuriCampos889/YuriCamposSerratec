programa
{
    funcao inicio()
    {
        // Declaração das variáveis
        inteiro estudantes
        real percentdisciplina1 = 35, percentdisciplina2 = 30, mediapercent, estudantesmadrugada

	        escreva("Digite o número total de estudantes na turma: ")
	        leia(estudantes)
	        limpa()
	
	        mediapercent = (percentdisciplina1 + percentdisciplina2) / 2
	
	        estudantesmadrugada = (mediapercent / 100) * estudantes
	
	        escreva("Média dos estudantes que estudam de madrugada (eu me incluo nessa): ", estudantesmadrugada, " estudantes\n")
	        escreva("quero dormir ~.~")
    }
}

